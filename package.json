{
  "name": "performance-kit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b && node scripts/emit-schemas.mjs && pnpm --filter @performance-kit/viewer build",
    "tsc": "tsc -b && pnpm --filter @performance-kit/viewer tsc",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "vitest run",
    "cli": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^25.6.0",
    "@types/yargs": "^17.0.35",
    "oxlint": "^1.73.0",
    "oxfmt": "^0.58.0",
    "vitest": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@changesets/cli": "^2.29.8"
  }
}
