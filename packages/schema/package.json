{
  "name": "performance-kit-schema",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "schemas"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./derive": {
      "types": "./dist/derive.d.ts",
      "import": "./dist/derive.js",
      "default": "./dist/derive.js"
    },
    "./colorScales": {
      "types": "./dist/colorScales.d.ts",
      "import": "./dist/colorScales.js",
      "default": "./dist/colorScales.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js",
      "default": "./dist/process.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "tsc": "tsc -b"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "ajv": "^8.17.1"
  }
}
