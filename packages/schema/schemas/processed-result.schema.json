{
  "additionalProperties": false,
  "$id": "https://bhouston.github.io/performance-kit/schema/v2/processed-result.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "screenshot",
    "entry",
    "config",
    "status",
    "statistics",
    "timeline",
    "measuredIntervalSeconds",
    "timing",
    "attribution"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "suiteName": {
      "type": "string"
    },
    "screenshot": {
      "type": "boolean"
    },
    "networkProfile": {
      "additionalProperties": false,
      "type": "object",
      "required": ["name", "latencyMs", "downloadBytesPerSec", "uploadBytesPerSec"],
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "latencyMs": {
          "minimum": 0,
          "type": "number"
        },
        "downloadBytesPerSec": {
          "anyOf": [
            {
              "const": -1,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ]
        },
        "uploadBytesPerSec": {
          "anyOf": [
            {
              "const": -1,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ]
        }
      }
    },
    "downloads": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "phase",
          "timeOrigin",
          "totalTransferBytes",
          "totalDecodedBytes",
          "byCategory",
          "unknownSizeCount",
          "resources"
        ],
        "properties": {
          "phase": {
            "anyOf": [
              {
                "const": "load",
                "type": "string"
              },
              {
                "const": "post-load",
                "type": "string"
              }
            ]
          },
          "timeOrigin": {
            "type": "number"
          },
          "totalTransferBytes": {
            "minimum": 0,
            "type": "number"
          },
          "totalDecodedBytes": {
            "minimum": 0,
            "type": "number"
          },
          "byCategory": {
            "additionalProperties": false,
            "type": "object",
            "required": ["script", "wasm", "model", "texture", "document", "other"],
            "properties": {
              "script": {
                "minimum": 0,
                "type": "number"
              },
              "wasm": {
                "minimum": 0,
                "type": "number"
              },
              "model": {
                "minimum": 0,
                "type": "number"
              },
              "texture": {
                "minimum": 0,
                "type": "number"
              },
              "document": {
                "minimum": 0,
                "type": "number"
              },
              "other": {
                "minimum": 0,
                "type": "number"
              }
            }
          },
          "unknownSizeCount": {
            "minimum": 0,
            "type": "integer"
          },
          "resources": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "url",
                "category",
                "initiatorType",
                "startTime",
                "responseStart",
                "responseEnd",
                "transferSize",
                "encodedBodySize",
                "decodedBodySize",
                "sizeKnown"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "category": {
                  "anyOf": [
                    {
                      "const": "script",
                      "type": "string"
                    },
                    {
                      "const": "wasm",
                      "type": "string"
                    },
                    {
                      "const": "model",
                      "type": "string"
                    },
                    {
                      "const": "texture",
                      "type": "string"
                    },
                    {
                      "const": "document",
                      "type": "string"
                    },
                    {
                      "const": "other",
                      "type": "string"
                    }
                  ]
                },
                "initiatorType": {
                  "type": "string"
                },
                "startTime": {
                  "minimum": 0,
                  "type": "number"
                },
                "responseStart": {
                  "minimum": 0,
                  "type": "number"
                },
                "responseEnd": {
                  "minimum": 0,
                  "type": "number"
                },
                "transferSize": {
                  "minimum": 0,
                  "type": "number"
                },
                "encodedBodySize": {
                  "minimum": 0,
                  "type": "number"
                },
                "decodedBodySize": {
                  "minimum": 0,
                  "type": "number"
                },
                "sizeKnown": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "entry": {
      "additionalProperties": false,
      "type": "object",
      "required": ["id", "name", "renderer", "scene", "url"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "renderer": {
          "additionalProperties": false,
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        "scene": {
          "additionalProperties": false,
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        "url": {
          "type": "string"
        }
      }
    },
    "config": {
      "additionalProperties": false,
      "type": "object",
      "required": ["durationSeconds", "vsync"],
      "properties": {
        "durationSeconds": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "vsync": {
          "anyOf": [
            {
              "const": "on",
              "type": "string"
            },
            {
              "const": "off",
              "type": "string"
            }
          ]
        },
        "phaseColors": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "minLength": 1,
              "type": "string"
            }
          }
        }
      }
    },
    "environment": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "userAgent",
        "gpuTimestampsAvailable",
        "crossOriginIsolated",
        "devicePixelRatio",
        "chromeFlags",
        "host"
      ],
      "properties": {
        "userAgent": {
          "type": "string"
        },
        "gpuAdapter": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "api": {
          "anyOf": [
            {
              "const": "webgpu",
              "type": "string"
            },
            {
              "const": "webgl2",
              "type": "string"
            },
            {
              "const": "other",
              "type": "string"
            }
          ]
        },
        "gpuTimestampsAvailable": {
          "type": "boolean"
        },
        "crossOriginIsolated": {
          "type": "boolean"
        },
        "devicePixelRatio": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "canvasSize": {
          "additionalProperties": false,
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "height": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          }
        },
        "chromeFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "additionalProperties": false,
          "type": "object",
          "required": ["os", "cpu"],
          "properties": {
            "os": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            },
            "machineId": {
              "type": "string"
            }
          }
        },
        "gitCommit": {
          "type": "string"
        }
      }
    },
    "status": {
      "anyOf": [
        {
          "const": "ok",
          "type": "string"
        },
        {
          "const": "timeout",
          "type": "string"
        },
        {
          "const": "error",
          "type": "string"
        }
      ]
    },
    "error": {
      "additionalProperties": false,
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        }
      }
    },
    "statistics": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "frameCount",
        "intervalCount",
        "cpuSampleCount",
        "gpuSampleCount",
        "setupMaxBlockSeconds",
        "setupBlockedSeconds",
        "phaseDurations"
      ],
      "properties": {
        "frameCount": {
          "minimum": 0,
          "type": "integer"
        },
        "intervalCount": {
          "minimum": 0,
          "type": "integer"
        },
        "cpuSampleCount": {
          "minimum": 0,
          "type": "integer"
        },
        "gpuSampleCount": {
          "minimum": 0,
          "type": "integer"
        },
        "median": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        },
        "p99": {
          "type": "number"
        },
        "iqr": {
          "type": "number"
        },
        "mad": {
          "type": "number"
        },
        "typicalFps": {
          "type": "number"
        },
        "tailFps": {
          "type": "number"
        },
        "setupSeconds": {
          "type": "number"
        },
        "unaccountedSeconds": {
          "type": "number"
        },
        "setupMaxBlockSeconds": {
          "type": "number"
        },
        "setupBlockedSeconds": {
          "type": "number"
        },
        "cpuMedian": {
          "type": "number"
        },
        "cpuP95": {
          "type": "number"
        },
        "gpuMedian": {
          "type": "number"
        },
        "gpuP95": {
          "type": "number"
        },
        "averageFrameSeconds": {
          "type": "number"
        },
        "averageFps": {
          "type": "number"
        },
        "maxJitterSeconds": {
          "type": "number"
        },
        "worstResponsivenessSeconds": {
          "type": "number"
        },
        "phaseDurations": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "type": "number"
            }
          }
        }
      }
    },
    "timeline": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "timeUnit",
        "valueUnit",
        "maxTime",
        "frameSeconds",
        "cpuSeconds",
        "gpuSeconds",
        "frameIndices",
        "watchdogSeconds",
        "watchdogIndices",
        "watchdogPeriodSeconds",
        "phases",
        "blocks"
      ],
      "properties": {
        "timeUnit": {
          "const": "seconds",
          "type": "string"
        },
        "valueUnit": {
          "const": "seconds",
          "type": "string"
        },
        "maxTime": {
          "minimum": 0,
          "type": "number"
        },
        "ready": {
          "type": "number"
        },
        "renderStart": {
          "type": "number"
        },
        "runStart": {
          "type": "number"
        },
        "runEnd": {
          "type": "number"
        },
        "frameSeconds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "cpuSeconds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "gpuSeconds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "frameIndices": {
          "maxItems": 1536,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "watchdogSeconds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "watchdogIndices": {
          "maxItems": 512,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "watchdogPeriodSeconds": {
          "const": 0.016,
          "type": "number"
        },
        "phases": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["phase", "start"],
            "properties": {
              "phase": {
                "minLength": 1,
                "type": "string"
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "durationSeconds": {
                "type": "number"
              }
            }
          }
        },
        "blocks": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["start", "end", "durationSeconds", "sources"],
            "properties": {
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "durationSeconds": {
                "type": "number"
              },
              "sources": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "measuredIntervalSeconds": {
      "type": "array",
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      }
    },
    "timing": {
      "additionalProperties": false,
      "type": "object",
      "required": ["timeUnit", "harness", "reporter", "messages"],
      "properties": {
        "timeUnit": {
          "const": "epochSeconds",
          "type": "string"
        },
        "harness": {
          "additionalProperties": false,
          "type": "object",
          "required": ["startSent", "teardown"],
          "properties": {
            "iframeCreated": {
              "type": "number"
            },
            "startSent": {
              "type": "number"
            },
            "runSent": {
              "type": "number"
            },
            "runEndObserved": {
              "type": "number"
            },
            "captureSent": {
              "type": "number"
            },
            "teardown": {
              "type": "number"
            }
          }
        },
        "reporter": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "hello": {
              "type": "number"
            },
            "startReceived": {
              "type": "number"
            },
            "ready": {
              "type": "number"
            },
            "renderStart": {
              "type": "number"
            },
            "runStart": {
              "type": "number"
            },
            "runEnd": {
              "type": "number"
            }
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["type", "direction", "sentAt", "receivedAt"],
            "properties": {
              "type": {
                "type": "string"
              },
              "direction": {
                "anyOf": [
                  {
                    "const": "toReporter",
                    "type": "string"
                  },
                  {
                    "const": "toHarness",
                    "type": "string"
                  }
                ]
              },
              "sentAt": {
                "additionalProperties": false,
                "type": "object",
                "required": ["clock", "t"],
                "properties": {
                  "clock": {
                    "anyOf": [
                      {
                        "const": "harness",
                        "type": "string"
                      },
                      {
                        "const": "reporter",
                        "type": "string"
                      }
                    ]
                  },
                  "t": {
                    "minimum": 0,
                    "type": "number"
                  }
                }
              },
              "receivedAt": {
                "additionalProperties": false,
                "type": "object",
                "required": ["clock", "t"],
                "properties": {
                  "clock": {
                    "anyOf": [
                      {
                        "const": "harness",
                        "type": "string"
                      },
                      {
                        "const": "reporter",
                        "type": "string"
                      }
                    ]
                  },
                  "t": {
                    "minimum": 0,
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "attribution": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["start", "end", "durationSeconds"],
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number"
          },
          "sourceURL": {
            "type": "string"
          },
          "invoker": {
            "type": "string"
          },
          "invokerType": {
            "type": "string"
          },
          "sourceFunctionName": {
            "type": "string"
          },
          "sourceCharPosition": {
            "type": "number"
          }
        }
      }
    }
  }
}
