{
  "additionalProperties": false,
  "$id": "https://bhouston.github.io/performance-kit/schema/v1/processed-result.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "screenshot",
    "entry",
    "config",
    "status",
    "statistics",
    "timeline",
    "histogram",
    "attribution"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "suiteName": {
      "type": "string"
    },
    "screenshot": {
      "type": "boolean"
    },
    "entry": {
      "additionalProperties": false,
      "type": "object",
      "required": ["id", "name", "renderer", "scene", "url"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "renderer": {
          "additionalProperties": false,
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        "scene": {
          "additionalProperties": false,
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        "url": {
          "type": "string"
        }
      }
    },
    "config": {
      "additionalProperties": false,
      "type": "object",
      "required": ["durationSeconds", "warmupSeconds", "vsync"],
      "properties": {
        "durationSeconds": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "warmupSeconds": {
          "minimum": 0,
          "type": "number"
        },
        "vsync": {
          "anyOf": [
            {
              "const": "on",
              "type": "string"
            },
            {
              "const": "off",
              "type": "string"
            }
          ]
        }
      }
    },
    "environment": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "userAgent",
        "gpuTimestampsAvailable",
        "crossOriginIsolated",
        "devicePixelRatio",
        "chromeFlags",
        "host"
      ],
      "properties": {
        "userAgent": {
          "type": "string"
        },
        "gpuAdapter": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "api": {
          "anyOf": [
            {
              "const": "webgpu",
              "type": "string"
            },
            {
              "const": "webgl2",
              "type": "string"
            },
            {
              "const": "other",
              "type": "string"
            }
          ]
        },
        "gpuTimestampsAvailable": {
          "type": "boolean"
        },
        "crossOriginIsolated": {
          "type": "boolean"
        },
        "devicePixelRatio": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "canvasSize": {
          "additionalProperties": false,
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "height": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          }
        },
        "chromeFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "additionalProperties": false,
          "type": "object",
          "required": ["os", "cpu"],
          "properties": {
            "os": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            },
            "machineId": {
              "type": "string"
            }
          }
        },
        "gitCommit": {
          "type": "string"
        }
      }
    },
    "status": {
      "anyOf": [
        {
          "const": "ok",
          "type": "string"
        },
        {
          "const": "timeout",
          "type": "string"
        },
        {
          "const": "error",
          "type": "string"
        }
      ]
    },
    "error": {
      "additionalProperties": false,
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        }
      }
    },
    "statistics": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "frameCount",
        "intervalCount",
        "cpuSampleCount",
        "gpuSampleCount",
        "setupMaxBlockSeconds",
        "setupBlockedSeconds",
        "phaseDurations"
      ],
      "properties": {
        "frameCount": {
          "minimum": 0,
          "type": "integer"
        },
        "intervalCount": {
          "minimum": 0,
          "type": "integer"
        },
        "cpuSampleCount": {
          "minimum": 0,
          "type": "integer"
        },
        "gpuSampleCount": {
          "minimum": 0,
          "type": "integer"
        },
        "median": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        },
        "p99": {
          "type": "number"
        },
        "iqr": {
          "type": "number"
        },
        "mad": {
          "type": "number"
        },
        "typicalFps": {
          "type": "number"
        },
        "tailFps": {
          "type": "number"
        },
        "setupSeconds": {
          "type": "number"
        },
        "reporterSetupSeconds": {
          "type": "number"
        },
        "hiddenStartupSeconds": {
          "type": "number"
        },
        "unaccountedSeconds": {
          "type": "number"
        },
        "setupMaxBlockSeconds": {
          "type": "number"
        },
        "setupBlockedSeconds": {
          "type": "number"
        },
        "offsetSeconds": {
          "type": "number"
        },
        "driftSeconds": {
          "type": "number"
        },
        "cpuMedian": {
          "type": "number"
        },
        "cpuP95": {
          "type": "number"
        },
        "gpuMedian": {
          "type": "number"
        },
        "gpuP95": {
          "type": "number"
        },
        "phaseDurations": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "load": {
              "type": "number"
            },
            "process": {
              "type": "number"
            },
            "compile": {
              "type": "number"
            }
          }
        }
      }
    },
    "timeline": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "timeUnit",
        "valueUnit",
        "maxTime",
        "frameSeconds",
        "cpuSeconds",
        "gpuSeconds",
        "frameIndices",
        "watchdogSeconds",
        "watchdogIndices",
        "watchdogPeriodSeconds",
        "phases",
        "blocks",
        "discrepancies"
      ],
      "properties": {
        "timeUnit": {
          "const": "seconds",
          "type": "string"
        },
        "valueUnit": {
          "const": "seconds",
          "type": "string"
        },
        "maxTime": {
          "minimum": 0,
          "type": "number"
        },
        "ready": {
          "type": "number"
        },
        "runStart": {
          "type": "number"
        },
        "runEnd": {
          "type": "number"
        },
        "frameSeconds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "cpuSeconds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "gpuSeconds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "frameIndices": {
          "maxItems": 1536,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "watchdogSeconds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "watchdogIndices": {
          "maxItems": 512,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "watchdogPeriodSeconds": {
          "const": 0.016,
          "type": "number"
        },
        "phases": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["phase", "start"],
            "properties": {
              "phase": {
                "anyOf": [
                  {
                    "const": "load",
                    "type": "string"
                  },
                  {
                    "const": "process",
                    "type": "string"
                  },
                  {
                    "const": "compile",
                    "type": "string"
                  }
                ]
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "durationSeconds": {
                "type": "number"
              }
            }
          }
        },
        "blocks": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["start", "end", "durationSeconds", "sources"],
            "properties": {
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "durationSeconds": {
                "type": "number"
              },
              "sources": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "discrepancies": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["name", "seconds", "flagged"],
            "properties": {
              "name": {
                "type": "string"
              },
              "seconds": {
                "type": "number"
              },
              "flagged": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "histogram": {
      "additionalProperties": false,
      "type": "object",
      "required": ["bins", "count", "maxCount"],
      "properties": {
        "bins": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["start", "end", "count"],
            "properties": {
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "count": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "maxCount": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "attribution": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["start", "end", "durationSeconds"],
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number"
          },
          "sourceURL": {
            "type": "string"
          },
          "invoker": {
            "type": "string"
          },
          "invokerType": {
            "type": "string"
          },
          "sourceFunctionName": {
            "type": "string"
          },
          "sourceCharPosition": {
            "type": "number"
          }
        }
      }
    }
  }
}
