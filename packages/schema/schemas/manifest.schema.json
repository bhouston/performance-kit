{
  "additionalProperties": false,
  "$id": "https://bhouston.github.io/performance-kit/schema/v1/manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "runSetId", "createdAt", "suite", "schedule"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "runSetId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "suite": {
      "additionalProperties": false,
      "$id": "https://bhouston.github.io/performance-kit/schema/v1/suite.schema.json",
      "type": "object",
      "required": ["schemaVersion", "name", "entries"],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "defaults": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "warmupMs": {
              "minimum": 0,
              "type": "number"
            },
            "repetitions": {
              "minimum": 1,
              "type": "integer"
            },
            "order": {
              "anyOf": [
                {
                  "const": "interleaved",
                  "type": "string"
                },
                {
                  "const": "sequential",
                  "type": "string"
                }
              ]
            },
            "setupTimeoutMs": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "captureAfterWarmup": {
              "type": "boolean"
            },
            "vsync": {
              "anyOf": [
                {
                  "const": "on",
                  "type": "string"
                },
                {
                  "const": "off",
                  "type": "string"
                }
              ]
            }
          }
        },
        "entries": {
          "minItems": 1,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["id", "name", "url", "durationMs"],
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "labels": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": ["key", "value"],
                  "properties": {
                    "key": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "url": {
                "minLength": 1,
                "type": "string"
              },
              "durationMs": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "warmupMs": {
                "minimum": 0,
                "type": "number"
              },
              "params": {
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {}
                }
              }
            }
          }
        }
      }
    },
    "schedule": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["entryId", "repetition"],
        "properties": {
          "entryId": {
            "type": "string"
          },
          "repetition": {
            "minimum": 1,
            "type": "integer"
          }
        }
      }
    },
    "seed": {
      "type": "number"
    },
    "gitCommit": {
      "type": "string"
    },
    "environment": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "userAgent",
        "gpuTimestampsAvailable",
        "crossOriginIsolated",
        "devicePixelRatio",
        "chromeFlags",
        "host"
      ],
      "properties": {
        "userAgent": {
          "type": "string"
        },
        "gpuAdapter": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "api": {
          "anyOf": [
            {
              "const": "webgpu",
              "type": "string"
            },
            {
              "const": "webgl2",
              "type": "string"
            },
            {
              "const": "other",
              "type": "string"
            }
          ]
        },
        "gpuTimestampsAvailable": {
          "type": "boolean"
        },
        "crossOriginIsolated": {
          "type": "boolean"
        },
        "devicePixelRatio": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "canvasSize": {
          "additionalProperties": false,
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "height": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          }
        },
        "chromeFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "additionalProperties": false,
          "type": "object",
          "required": ["os", "cpu"],
          "properties": {
            "os": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            },
            "machineId": {
              "type": "string"
            }
          }
        },
        "gitCommit": {
          "type": "string"
        }
      }
    }
  }
}
