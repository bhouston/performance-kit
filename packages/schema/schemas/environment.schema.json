{
  "additionalProperties": false,
  "type": "object",
  "required": ["protocol", "protocolVersion", "runId", "seq", "type", "sentAt", "payload"],
  "properties": {
    "protocol": {
      "const": "performance-kit",
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "const": "environment",
      "type": "string"
    },
    "sentAt": {
      "minimum": 0,
      "type": "number"
    },
    "payload": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "userAgent": {
          "type": "string"
        },
        "gpuAdapter": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "api": {
          "anyOf": [
            {
              "const": "webgpu",
              "type": "string"
            },
            {
              "const": "webgl2",
              "type": "string"
            },
            {
              "const": "other",
              "type": "string"
            }
          ]
        },
        "gpuTimestampsAvailable": {
          "type": "boolean"
        },
        "crossOriginIsolated": {
          "type": "boolean"
        },
        "devicePixelRatio": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "canvasSize": {
          "additionalProperties": false,
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "height": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          }
        },
        "chromeFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "additionalProperties": false,
          "type": "object",
          "required": ["os", "cpu"],
          "properties": {
            "os": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            },
            "machineId": {
              "type": "string"
            }
          }
        },
        "gitCommit": {
          "type": "string"
        }
      }
    }
  },
  "$id": "https://bhouston.github.io/performance-kit/schema/v1/environment.schema.json"
}
