{
  "additionalProperties": false,
  "type": "object",
  "required": ["protocol", "protocolVersion", "runId", "seq", "type", "sentAt", "payload"],
  "properties": {
    "protocol": {
      "const": "performance-kit",
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "const": "hello",
      "type": "string"
    },
    "sentAt": {
      "minimum": 0,
      "type": "number"
    },
    "payload": {
      "additionalProperties": false,
      "type": "object",
      "required": ["reporterVersion", "capabilities"],
      "properties": {
        "reporterVersion": {
          "type": "string"
        },
        "capabilities": {
          "additionalProperties": false,
          "type": "object",
          "required": ["gpuTimestamps", "longTasks", "loaf"],
          "properties": {
            "gpuTimestamps": {
              "type": "boolean"
            },
            "longTasks": {
              "type": "boolean"
            },
            "loaf": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "$id": "https://bhouston.github.io/performance-kit/schema/v1/hello.schema.json"
}
