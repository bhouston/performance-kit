{
  "additionalProperties": false,
  "type": "object",
  "required": ["protocol", "protocolVersion", "runId", "seq", "type", "sentAt", "payload"],
  "properties": {
    "protocol": {
      "const": "performance-kit",
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "const": "download-report",
      "type": "string"
    },
    "sentAt": {
      "minimum": 0,
      "type": "number"
    },
    "payload": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "phase",
        "timeOrigin",
        "totalTransferBytes",
        "totalDecodedBytes",
        "byCategory",
        "unknownSizeCount",
        "resources"
      ],
      "properties": {
        "phase": {
          "anyOf": [
            {
              "const": "load",
              "type": "string"
            },
            {
              "const": "post-load",
              "type": "string"
            }
          ]
        },
        "timeOrigin": {
          "type": "number"
        },
        "totalTransferBytes": {
          "minimum": 0,
          "type": "number"
        },
        "totalDecodedBytes": {
          "minimum": 0,
          "type": "number"
        },
        "byCategory": {
          "additionalProperties": false,
          "type": "object",
          "required": ["script", "wasm", "model", "texture", "document", "other"],
          "properties": {
            "script": {
              "minimum": 0,
              "type": "number"
            },
            "wasm": {
              "minimum": 0,
              "type": "number"
            },
            "model": {
              "minimum": 0,
              "type": "number"
            },
            "texture": {
              "minimum": 0,
              "type": "number"
            },
            "document": {
              "minimum": 0,
              "type": "number"
            },
            "other": {
              "minimum": 0,
              "type": "number"
            }
          }
        },
        "unknownSizeCount": {
          "minimum": 0,
          "type": "integer"
        },
        "resources": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "url",
              "category",
              "initiatorType",
              "startTime",
              "responseStart",
              "responseEnd",
              "transferSize",
              "encodedBodySize",
              "decodedBodySize",
              "sizeKnown"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "category": {
                "anyOf": [
                  {
                    "const": "script",
                    "type": "string"
                  },
                  {
                    "const": "wasm",
                    "type": "string"
                  },
                  {
                    "const": "model",
                    "type": "string"
                  },
                  {
                    "const": "texture",
                    "type": "string"
                  },
                  {
                    "const": "document",
                    "type": "string"
                  },
                  {
                    "const": "other",
                    "type": "string"
                  }
                ]
              },
              "initiatorType": {
                "type": "string"
              },
              "startTime": {
                "minimum": 0,
                "type": "number"
              },
              "responseStart": {
                "minimum": 0,
                "type": "number"
              },
              "responseEnd": {
                "minimum": 0,
                "type": "number"
              },
              "transferSize": {
                "minimum": 0,
                "type": "number"
              },
              "encodedBodySize": {
                "minimum": 0,
                "type": "number"
              },
              "decodedBodySize": {
                "minimum": 0,
                "type": "number"
              },
              "sizeKnown": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "$id": "https://bhouston.github.io/performance-kit/schema/v1/downloadReport.schema.json"
}
