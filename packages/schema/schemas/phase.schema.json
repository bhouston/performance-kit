{
  "additionalProperties": false,
  "type": "object",
  "required": ["protocol", "protocolVersion", "runId", "seq", "type", "sentAt", "payload"],
  "properties": {
    "protocol": {
      "const": "performance-kit",
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "const": "phase",
      "type": "string"
    },
    "sentAt": {
      "minimum": 0,
      "type": "number"
    },
    "payload": {
      "additionalProperties": false,
      "type": "object",
      "required": ["phase", "start"],
      "properties": {
        "phase": {
          "anyOf": [
            {
              "const": "load",
              "type": "string"
            },
            {
              "const": "process",
              "type": "string"
            },
            {
              "const": "compile",
              "type": "string"
            }
          ]
        },
        "start": {
          "additionalProperties": false,
          "type": "object",
          "required": ["clock", "t"],
          "properties": {
            "clock": {
              "anyOf": [
                {
                  "const": "harness",
                  "type": "string"
                },
                {
                  "const": "reporter",
                  "type": "string"
                }
              ]
            },
            "t": {
              "minimum": 0,
              "type": "number"
            }
          }
        },
        "end": {
          "additionalProperties": false,
          "type": "object",
          "required": ["clock", "t"],
          "properties": {
            "clock": {
              "anyOf": [
                {
                  "const": "harness",
                  "type": "string"
                },
                {
                  "const": "reporter",
                  "type": "string"
                }
              ]
            },
            "t": {
              "minimum": 0,
              "type": "number"
            }
          }
        }
      }
    }
  },
  "$id": "https://bhouston.github.io/performance-kit/schema/v1/phase.schema.json"
}
